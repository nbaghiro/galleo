#!/bin/sh
# Keep main green: run the same checks as CI before every commit.
# (Wired up by `pnpm install` via the "prepare" script → git core.hooksPath = .githooks.)
# Integration tests need Postgres, so they stay CI-only; run `pnpm test:int` by hand when touching services.
set -e

echo "▸ suppression guard"
pnpm check:suppressions

echo "▸ prettier --check"
pnpm exec prettier --check .

echo "▸ eslint"
pnpm lint

echo "▸ boundary self-check"
pnpm check:boundaries

echo "▸ model-id guard"
pnpm check:models

echo "▸ typecheck"
pnpm typecheck

echo "▸ program-membership guard"
pnpm check:program

echo "▸ test"
pnpm test

echo "✓ pre-commit checks passed"
