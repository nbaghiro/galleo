{
    "name": "galleo",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "check:suppressions": "node scripts/check-suppressions.mjs",
        "check:program": "node scripts/check-tsc-program.mjs",
        "check:models": "node scripts/check-models.mjs",
        "check:elements": "tsx scripts/check-elements.ts",
        "eval:diagrams": "vitest run canvas/elements/diagram/__tests__/visual-invariants.test.ts",
        "check:boundaries": "node scripts/check-boundaries.mjs",
        "check:copy": "node scripts/check-copy.mjs",
        "check:modules": "node scripts/check-modules.mjs",
        "check:maps": "node scripts/check-maps.mjs",
        "check:validation": "node scripts/check-validation.mjs",
        "check:tools": "tsx scripts/check-tools.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:int": "vitest run -c vitest.integration.config.ts",
        "test:browser": "vitest run -c vitest.browser.config.ts",
        "test:e2e": "playwright test",
        "test:e2e:smoke": "playwright test --project=smoke",
        "test:e2e:ai": "playwright test --project=ai",
        "test:e2e:ai:live": "E2E_LIVE_AI=1 playwright test --project=ai --workers=1",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "git config core.hooksPath .githooks || true",
        "dev": "vite",
        "build": "vite build",
        "start": "NODE_ENV=production tsx services/server.ts",
        "preview": "vite preview",
        "preapi": "bash scripts/ensure-db.sh",
        "api": "tsx watch services/server.ts",
        "api:watch": "tsx watch services/server.ts",
        "seed": "tsx services/db/seed.ts",
        "ai:eval": "tsx services/core/ai/eval/harness.ts",
        "ai:probe": "tsx services/core/ai/eval/probe.ts",
        "db:push": "drizzle-kit push",
        "eval:ci": "tsx scripts/eval-ci.ts",
        "migrate:container": "tsx scripts/migrate-container.ts",
        "onboarding:reset": "tsx scripts/onboarding-reset.ts",
        "eval:shots": "tsx scripts/eval-shots.ts",
        "stripe:setup": "tsx scripts/stripe-setup.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "media:migrate": "tsx scripts/migrate-media-assets.ts",
        "media:collect": "tsx scripts/collect-media-assets.ts",
        "fonts:vendor": "tsx scripts/fonts-vendor.ts",
        "check:fonts": "tsx scripts/check-fonts.ts",
        "mcp": "tsx scripts/mcp.ts",
        "posthog:dashboards": "tsx scripts/posthog-dashboards.ts"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.30",
        "@ai-sdk/google": "^4.0.34",
        "@ai-sdk/openai": "^4.0.30",
        "@ai-sdk/xai": "^4.0.28",
        "@hono/node-server": "^2.0.6",
        "@hono/node-ws": "^1.3.1",
        "@pdf-lib/fontkit": "^1.1.1",
        "@solidjs/router": "^0.16.1",
        "ai": "^7.0.15",
        "arctic": "^3.7.0",
        "d3-hierarchy": "^3.1.2",
        "d3-scale": "^4.0.2",
        "d3-shape": "^3.2.0",
        "dompurify": "^3.4.11",
        "drizzle-kit": "^0.30.1",
        "drizzle-orm": "^0.38.0",
        "hono": "^4.12.27",
        "jszip": "^3.10.1",
        "marked": "^18.0.6",
        "pdf-lib": "^1.17.1",
        "postgres": "^3.4.5",
        "posthog-js": "^1.418.6",
        "posthog-node": "^5.49.2",
        "pptxgenjs": "^4.0.1",
        "solid-js": "^1.9.13",
        "stripe": "^22.3.0",
        "tsx": "^4.22.4",
        "unpdf": "^1.8.0",
        "wawoff2": "^2.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.3.1",
        "@types/d3-hierarchy": "^3.1.7",
        "@types/d3-scale": "^4.0.9",
        "@types/d3-shape": "^3.1.8",
        "@types/node": "^22.10.5",
        "@vitest/coverage-v8": "^4.1.10",
        "dotenv": "^17.4.2",
        "esbuild": "^0.28.2",
        "eslint": "^9.18.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.31.0",
        "happy-dom": "^20.10.6",
        "playwright": "^1.62.1",
        "prettier": "^3.4.2",
        "tailwindcss": "^4.3.1",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.19.1",
        "vite": "^8.1.0",
        "vite-plugin-solid": "^2.11.12",
        "vitest": "^4.1.10"
    }
}
