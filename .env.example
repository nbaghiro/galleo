# Copy to .env for local dev. Postgres host port is 8602 (see .docs/architecture.md).
DATABASE_URL=postgres://galleo:galleo@localhost:8602/galleo
SESSION_SECRET=dev-secret-change-me
API_PORT=8601

# --- OAuth sign-in (Google) ---
# Routes report "not configured" until the id + secret are set (the auth page disables the button).
# Register the redirect URI EXACTLY as ${APP_URL}/api/auth/google/callback — for local dev that is
#   http://localhost:8600/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Transactional email (Resend) — confirmation codes, password reset + share invites ---
# Set it and localhost delivers for real, which is the only way to check what an email actually looks
# like. Blank = dev mode: every message is written to the API server log instead, prefixed
# `[email:dev]`, so the confirmation code is readable there and the flows stay testable with no
# provider. Get a key at resend.com; a send-only key is enough. Both test runners blank this
# explicitly, so no suite can mail a real address whatever is in .env.
#
# The sender and reply-to are constants in services/core/mail.ts, not config: DMARC on galleo.app
# demands strict DKIM alignment, so the From has to stay on the apex the Resend key signs for.
RESEND_API_KEY=

# --- Auth rate limiting ---
# The per-IP limiter derives the client IP from this header (Cloudflare/Render set cf-connecting-ip and
# strip client-sent copies, so it's unspoofable). Change it only behind a different trusted proxy; unset
# falls back to the socket peer. Never trust raw X-Forwarded-For here.
CLIENT_IP_HEADER=cf-connecting-ip

# --- LLM providers (services/core/ai) ---
# One key is enough to turn AI generation on, and every task defaults to Google Gemini Flash
# (DEFAULT_MODELS in services/core/models.ts), so GOOGLE_API_KEY is the one to set first: it also
# carries image/video generation and the embeddings behind context and chat memory. The other three
# are the providers a task can be pinned onto; the registry serves no others.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
XAI_API_KEY=

# ElevenLabs, used for two things. Voice dictation in chat (Scribe realtime): the chat mic hides
# until this is set, and the server only mints single-use tokens, so audio streams browser →
# ElevenLabs directly. And narration: speaker notes synthesized to cached per-section audio, which
# runs server-side because a published link plays it for people who have no credentials. Without
# this key both are absent rather than broken.
#
# A RESTRICTED key needs the right scopes or narration fails with an error naming the one it wants:
# `text_to_speech` to synthesize, plus `voices_read` and `add_voice_from_voice_library` so a
# workspace can browse the voice library and adopt what it picks. Dictation alone needs none of those.
#
# A FREE ElevenLabs account can browse and adopt a library voice and is then refused at synthesis
# ("Free users cannot use library voices via the API"), so narration falls back to a premade voice,
# which carries no such restriction. Premade voices retire on 31 December 2026; a paid account uses
# the library and is unaffected. See PREMADE_FALLBACK in services/core/voices.ts.
ELEVENLABS_API_KEY=

# --- Media picker (services/api/media) ---
# Stock search reports each provider "not configured" until its key is set; the picker's Generate mode
# uses GOOGLE_API_KEY (above). Register a free app with each provider to get a key.
UNSPLASH_ACCESS_KEY=   # unsplash.com/developers  (also requires visible attribution)
PEXELS_API_KEY=        # pexels.com/api
PIXABAY_API_KEY=       # pixabay.com/api/docs
GIPHY_API_KEY=         # developers.giphy.com  (GIFs + stickers)
# Optional: override either generation model if Google moves it. Defaults are gemini-3.1-flash-image
# and veo-3.1-fast-generate-preview (services/core/media.ts).
GEMINI_IMAGE_MODEL=
GEMINI_VIDEO_MODEL=

# --- Stripe billing (use TEST-mode keys for QA) ---
# Billing routes report "not configured" until STRIPE_SECRET_KEY + both plan price ids are set.
# 1. Set STRIPE_SECRET_KEY, then run `pnpm stripe:setup` (`--dry-run` first): it creates every
#    product and price from the catalog in model/billing.ts and prints the block below, filled in.
#    It is idempotent, so re-run it after a price change and point it at a new account by exporting
#    that account's key. 2. Run `stripe listen --forward-to localhost:8601/api/billing/webhook` and
#    paste the printed whsec_ into STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTH=price_...
STRIPE_PRICE_PRO_YEAR=price_...
STRIPE_PRICE_PREMIUM_MONTH=price_...
STRIPE_PRICE_PREMIUM_YEAR=price_...
# The seat add-on: a RECURRING price, since a seat is an ongoing entitlement. It rides the same
# subscription as an extra item. The annual key has no monthly fallback, because Stripe rejects a
# subscription whose items disagree on interval.
STRIPE_PRICE_SEAT_MONTH=price_...
STRIPE_PRICE_SEAT_YEAR=price_...
# Bought credits: ONE one-off price standing for a SINGLE credit, charged by quantity, so any
# amount is purchasable. Not recurring: a bought credit lands in the workspace balance, which
# carries over, so nothing has to bill monthly to keep it alive.
STRIPE_PRICE_CREDIT=price_...
# Customer Portal configuration id (plan-switching + cancel flow). Create it once via the API
# (billing_portal.configurations) — optional; without it the portal uses the account's default config.
STRIPE_PORTAL_CONFIG=bpc_...
# Where Stripe returns the user after Checkout / the portal (the SPA origin).
APP_URL=http://localhost:8600


# --- Product analytics (PostHog, US Cloud) ---
# Blank = disabled: the server and browser wrappers make no network calls and print nothing, so dev,
# CI and the test suite never emit. Both keys are the same public `phc_` project key; it is write-only
# and ships in the browser bundle by design. Browser events go to /api/i/*, a first-party path that
# forwards to POSTHOG_HOST, so ad blockers do not see a third-party origin.
POSTHOG_KEY=
VITE_POSTHOG_KEY=
# Ingest host. Defaults to https://us.i.posthog.com; set only to move region or point at a proxy.
POSTHOG_HOST=
# The PostHog app origin, used for links that must resolve past the proxy.
VITE_POSTHOG_HOST=
